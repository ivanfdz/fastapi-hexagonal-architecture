[flake8]
max-line-length = 100
extend-exclude = .venv,build,dist,*.egg-info
# E203: conflicts with how slices are formatted by black-style tooling.
extend-ignore = E203
per-file-ignores =
    # Layer __init__ files re-export names for convenience; that is the point.
    src/lending/**/__init__.py:F401
    src/lending/__init__.py:F401
    tests/__init__.py:F401
